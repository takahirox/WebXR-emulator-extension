{
  "name": "WebXR-Emulator-Extension-WebXR-Polyfill",
  "version": "0.0.1",
  "main": "polyfill/webxr-polyfill.js",
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.emit.json && tsx build.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "tsx tests/browser-smoke.ts",
    "build:firefox": "npm run build && tsx build-firefox.ts",
    "test:wpt": "tsx tests/wpt.ts",
    "test:samples": "tsx tests/samples.ts",
    "test:environment": "tsx --test tests/environment.ts tests/play-area.ts",
    "test:firefox": "tsx tests/firefox.ts",
    "test:extension-lifetime": "tsx tests/extension-lifetime.ts",
    "test:visibility:chromium": "tsx tests/visibility-browser.ts chromium",
    "test:visibility:firefox": "tsx tests/visibility-browser.ts firefox",
    "test:reference-space:chromium": "tsx tests/reference-space-browser.ts chromium",
    "test:reference-space:firefox": "tsx tests/reference-space-browser.ts firefox",
    "test:tracking:chromium": "tsx tests/tracking.ts chromium",
    "test:tracking:firefox": "tsx tests/tracking.ts firefox"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "playwright": "^1.64.0",
    "rollup": "^4.0.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "three": "0.186.1"
  },
  "type": "module"
}
